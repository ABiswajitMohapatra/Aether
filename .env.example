DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional generative planner. If unset or unreachable, Aether uses the
# adaptive policy engine and still runs real ML experiments.
FORCE_POLICY_ENGINE=0

# OpenAI or any OpenAI-compatible server (including Ollama's /v1 endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Native Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
